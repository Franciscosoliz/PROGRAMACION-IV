<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:title="Gestión Taller Mecánico"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:gravity="end|center_vertical"
        android:padding="12dp"
        android:text="Seleccione acción"
        android:textSize="32sp"
        android:background="#0b1220"
        android:textColor="#ffffff"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/grid"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"/>

    <GridLayout
        android:id="@+id/grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:rowCount="5"
        android:columnCount="4"
        android:useDefaultMargins="true"
        app:layout_constraintTop_toBottomOf="@id/tvDisplay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fila 1 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAC"
            android:text="Nuevo Vehículo"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnSpan="2"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:text="Editar Ficha"
            android:layout_row="0"
            android:layout_column="2"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiv"
            android:text="Eliminar Registro"
            android:layout_row="0"
            android:layout_column="3"/>

        <!-- Fila 2 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn7"
            android:text="Repuestos +1"
            android:layout_row="1"
            android:layout_column="0"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn8"
            android:text="Repuestos +5"
            android:layout_row="1"
            android:layout_column="1"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn9"
            android:text="Entradas Taller"
            android:layout_row="1"
            android:layout_column="2"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMul"
            android:text="Salidas Taller"
            android:layout_row="1"
            android:layout_column="3"/>

        <!-- Fila 3 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn4"
            android:text="Repuestos -1"
            android:layout_row="2"
            android:layout_column="0"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn5"
            android:text="Repuestos -5"
            android:layout_row="2"
            android:layout_column="1"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn6"
            android:text="Disponibilidad"
            android:layout_row="2"
            android:layout_column="2"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSub"
            android:text="Costo Servicio"
            android:layout_row="2"
            android:layout_column="3"/>

        <!-- Fila 4 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1"
            android:text="Buscar Vehículo"
            android:layout_row="3"
            android:layout_column="0"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn2"
            android:text="Reparación"
            android:layout_row="3"
            android:layout_column="1"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn3"
            android:text="Placa"
            android:layout_row="3"
            android:layout_column="2"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            android:text="Cotizar"
            android:layout_row="3"
            android:layout_column="3"/>

        <!-- Fila 5 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn0"
            android:text="Historial Mecánico"
            android:layout_row="4"
            android:layout_column="0"
            android:layout_columnSpan="2"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDot"
            android:text="Notas Mecánico"
            android:layout_row="4"
            android:layout_column="2"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEq"
            android:text="Guardar Servicio"
            android:layout_row="4"
            android:layout_column="3"/>

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
